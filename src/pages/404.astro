---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found">
  <h1 class="reveal" style="--i: 0">Not found</h1>
  <p class="reveal" style="--i: 1">That page doesn’t exist. <a href="/">Back home</a>.</p>
</BaseLayout>

<style>
  h1 {
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 600;
    line-height: 1;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }
</style>
